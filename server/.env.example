PORT=5000
NODE_ENV=production
JWT_SECRET=super-secret-jwt-key-secure-exam-2026-sha256-kms-key
JWT_EXPIRES_IN=8h

# Supabase Connection URL (Use Transaction Pooler port 6543 for Vercel)
# Format: postgres://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=

# Supabase Client API Config
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here

